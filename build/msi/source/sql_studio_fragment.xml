<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <?if $(var.SETUP_TYPE) = "commercial" ?>
  <?define PRODUCT_NAME  = "SqlStudio $(var.VERSION_MAIN)"?>
  <?elseif $(var.SETUP_TYPE) = "community" ?>
  <?define PRODUCT_NAME  = "SqlStudio $(var.VERSION_MAIN) CE"?>
  <?else?>
  <?define PRODUCT_NAME  = "SqlStudio $(var.VERSION_MAIN) Debug"?>
  <?endif?>

  <Fragment>

    <!-- *****************************************************************************************
      Icons
    -->

    <Icon Id="WBIcon.exe" SourceFile="$(var.InstallerSourceDir)resources/SqlStudio.ico" />

    <!-- *****************************************************************************************
      Directories / Files

      The components below need hand-authored entries (shortcut, file
      associations, edition-specific files). Everything else in the staged
      distribution is harvested at build time by the Payload component group,
      so the installer always matches what the build produces.
    -->

      <StandardDirectory Id="ProgramMenuFolder">
        <Directory Id="MysqlProgramMenuFolder" Name="MySQL" />
      </StandardDirectory>

      <StandardDirectory Id="ProgramFiles6432Folder">
        <Directory Id="MYSQL" Name="MySQL">
          <Directory FileSource=".\" Id="Mysql_WB_Dir" Name="$(var.PRODUCT_NAME)">
            <Directory Id="INSTALLDIR" Name=".">
              <!-- Referenced by the cleanup entries in sql_studio.xml. -->
              <Directory Id="python" Name="python">
                <Directory Id="python_lib" Name="lib">
                  <Directory Id="python_lib_ctypes" Name="ctypes" />
                </Directory>
                <Directory Id="python_site_packages" Name="site-packages" />
              </Directory>
              <Directory Id="library_studio" Name="studio" />
              <?if $(var.LICENSE_TYPE) = "commercial"?>
              <Directory Id="modules" Name="modules">
                <Directory Id="modules_wba_audit" Name="wba_audit" />
                <Directory Id="modules_wba_meb" Name="wba_meb" />
                <Directory Id="modules_wba_firewall" Name="wba_firewall" />
              </Directory>
              <?endif?>

              <Component DiskId="1" Guid="4E9CC25E-CB45-47e5-931E-DB57AC74991D" Id="Various" Location="either">
                <?if $(var.LICENSE_TYPE) = "community"?>
                <File Id="README" Name="README.md" />
                <?elseif $(var.LICENSE_TYPE) = "commercial"?>
                <File Id="README" Name="README-commercial.md" />
                <?endif?>
                <?if $(var.LICENSE_TYPE) = "community"?>
                <File Id="License.txt" Name="License.txt" />
                <?elseif $(var.LICENSE_TYPE) = "commercial"?>
                <File Id="License_commercial.txt" Name="License-commercial.txt" />
                <?endif?>
                <RemoveFolder Directory="Mysql_WB_Dir" Id="RemoveWbDirFolder" On="uninstall" />
                <RemoveFolder Directory="MysqlProgramMenuFolder" Id="RemoveProgramMenuFolder" On="uninstall" />
              </Component>

              <Component DiskId="1" Guid="47641656-8430-4722-B558-DAE76CA7C0CA" Id="SqlStudio.exe" Location="either">
                <File Id="file1056" KeyPath="yes" Name="SqlStudio.exe" />
                <File Id="SqlStudio.exe.config" Name="SqlStudio.exe.config" />
                <File Id="SqlStudioDoc.ico" Name="SqlStudioDoc.ico" />

                <RegistryValue Action="write" Id="Reg.Extn.MWB" Key=".mwb" Root="HKCR" Type="string" Value="MWBfile" />

                <RegistryKey ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes" Id="Reg.Class.MWB" Key="MWBfile" Root="HKCR">
                  <RegistryValue Id="Reg.Class.MWB.Value" Type="string" Value="SqlStudio File" />
                  <RegistryValue Id="Reg.Class.MWB.Icon" Key="DefaultIcon" Type="string" Value="[#SqlStudioDoc.ico],0" />
                  <RegistryValue Action="write" Id="Reg.Class.MWB.Command" Key="Shell\Open\Command" Type="string" Value="&quot;[#file1056]&quot; &quot;%1&quot;" />
                </RegistryKey>

                <RegistryValue Action="write" Id="Reg.Extn.SQL" Key=".sql" Root="HKCR" Type="string" Value="SQLFile" />

                <RegistryKey ForceCreateOnInstall="yes" Id="Reg.Class.SQL" Key="SQLfile" Root="HKCR">
                  <RegistryValue Id="Reg.Class.SQL.Value" Type="string" Value="SQL Text File" />
                  <RegistryValue Id="Reg.Class.SQL.Icon" Key="DefaultIcon" Type="string" Value="[#SqlStudioDoc.ico],0" />
                  <RegistryValue Action="write" Id="Reg.Class.SQL.Command" Key="Shell\Open\Command" Type="string" Value="&quot;[#file1056]&quot; &quot;%1&quot;" />
                </RegistryKey>

              </Component>

              <Component DiskId="1" Guid="5EDFE6C6-57CB-44BB-97B9-CA7CAA96E0A0" Id="SqlStudioProgramLink" Location="either">
                <RegistryKey ForceCreateOnInstall="yes" ForceDeleteOnUninstall="yes" Key="SOFTWARE\MySQL AB\[ProductName] \Install" Root="HKCU">
                  <RegistryValue KeyPath="yes" Name="ProgramSC" Type="integer" Value="1" />
                </RegistryKey>
                <Shortcut Advertise="no" Description="SqlStudio Visual Database Designer" Directory="MysqlProgramMenuFolder" Icon="WBIcon.exe" IconIndex="0" Id="WBProgramShortcut" Name="$(var.PRODUCT_NAME)" Show="normal" Target="[INSTALLDIR]SqlStudio.exe" WorkingDirectory="INSTALLDIR" />
              </Component>
            </Directory>
          </Directory>
        </Directory>
      </StandardDirectory>

      <ComponentGroup Id="Payload" Directory="INSTALLDIR">
        <Files Include="$(var.PayloadDirectory)\**">
          <Exclude Files="$(var.PayloadDirectory)\SqlStudio.exe" />
          <Exclude Files="$(var.PayloadDirectory)\SqlStudio.exe.config" />
          <Exclude Files="$(var.PayloadDirectory)\SqlStudioDoc.ico" />
          <Exclude Files="$(var.PayloadDirectory)\README*.md" />
          <Exclude Files="$(var.PayloadDirectory)\License*.txt" />
        </Files>
      </ComponentGroup>
    </Fragment>
</Wix>
